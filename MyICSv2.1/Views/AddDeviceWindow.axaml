<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MyICSv2._1.ViewModels"
        mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="200"
        x:Class="MyICSv2._1.Views.AddDeviceWindow"
        x:DataType="vm:MainViewModel"
        Title="Add Process"
        Width="300"
        Height="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    
    <ScrollViewer>
        <StackPanel Margin="15" Spacing="10">
            <!--Create new Device-->
            <TextBlock Text="Device ID" />
            <TextBox x:Name="DeviceNameField" PlaceholderText="Enter Device ID..." />

            <!--Assign Device to Process-->
            <TextBlock Text="Assign to Process" />
            <ComboBox x:Name="ProcessComboBox" 
                    PlaceholderText="Choose a Process"
                    ItemsSource="{Binding Processes}"
                    SelectedItem="{Binding SelectedProcess}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ProcessId}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
           
            <TextBlock Text="Sub-Process" />
            <TextBox x:Name="SubProcessField" MaxLength="12" />
            
            <TextBlock Text="Reading Type" />
            <TextBox x:Name="ReadingTypeField" MaxLength="5" />
            
            <TextBlock Text="Device Average" />
            <TextBox x:Name="DeviceAverageField" MaxLength="5" />
            
            <TextBlock Text="IPv4 Address" />
            <TextBox x:Name="IPv4Field" MaxLength="15" Watermark="192.168.1.10" />
            
            <TextBlock Text="IPv6 Address" />
            <TextBox x:Name="IPv6Field" MaxLength="39" />
            
            <TextBlock Text="Status" />
            <TextBox x:Name="StatusField" Text="Unknown" />
            
            <TextBlock Text="Security" />
            <ComboBox x:Name="SecurityComboBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                <ComboBoxItem>AES256</ComboBoxItem>
                <ComboBoxItem>AES128</ComboBoxItem>
                <ComboBoxItem>None</ComboBoxItem>
            </ComboBox>
            
            <CheckBox x:Name="IsActiveCheck" Content="Active" IsThreeState="True" IsChecked="{x:Null}" />
            <TextBlock x:Name="ErrorText" Foreground="Red" IsVisible="False" /> 

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0 15 0 0">
                <Button Content="Cancel" Click="OnClick_Cancel" Width="70" />
                <Button Content="Save" Click="OnClick_Save" Width="70" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
