<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="200"
        x:Class="MyICSv2._1.Views.AddProcessWindow"
        Title="Add Process"
        Width="300"
        Height="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <StackPanel Margin="15" Spacing="10">
        <!--Create new Process-->
        <TextBlock Text="Process ID" />
        <TextBox x:Name="ProcessIdField" PlaceholderText="Enter process ID..." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0 15 0 0">
            <Button Content="Cancel" Click="OnClick_Cancel" Width="70" />
            <Button Content="Save" Click="OnClick_Save" Width="70" />
        </StackPanel>
    </StackPanel>
</Window>
